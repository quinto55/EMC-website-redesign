# Cache times for the new site's files on Cloudflare, the same as emc-site/.htaccess sets on Apache.
# Pages themselves keep Cloudflare's default (always checked for a newer copy).
/emc-site/assets/*
  Cache-Control: public, max-age=31536000, immutable
/emc-site/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/emc-site/video/*
  Cache-Control: public, max-age=3600
/emc-site/curtain/*
  Cache-Control: public, max-age=604800
/emc-site/img/*
  Cache-Control: public, max-age=604800
/emc-site/icons/*
  Cache-Control: public, max-age=604800
/emc-site/logos/*
  Cache-Control: public, max-age=604800
/emc-site/work/*
  Cache-Control: public, max-age=604800
/emc-site/og-image.png
  Cache-Control: public, max-age=604800
/emc-site/site.webmanifest
  Cache-Control: public, max-age=604800
