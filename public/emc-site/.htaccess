# Cache and file-type settings for the new site's files. Applies only to this folder.
# Every directive sits inside a guard, so a module the host lacks cannot cause a server error.
# The videos are re-recorded under the same file names, so they are cached for one hour only.
# The home page curtain's footage and still (curtain/) are cached for one week.

<IfModule mod_mime.c>
# Make sure the host knows these file types.
AddType video/mp4 .mp4
AddType video/webm .webm
AddType image/avif .avif
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
# Compress styles, scripts, svg and json on the way out (about a third of the size). Images, fonts and videos are
# already compressed, so they are left alone. SetOutputFilter is a core directive, so this guard is all it needs.
<FilesMatch "\.(css|js|svg|json|webmanifest)$">
SetOutputFilter DEFLATE
</FilesMatch>
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
# Images, logos and icons: one week.
<FilesMatch "\.(jpe?g|png|webp|avif|svg|ico|webmanifest)$">
ExpiresDefault "access plus 1 week"
</FilesMatch>
# Hashed build files (assets/) and fonts: one year.
<FilesMatch "\.(js|css|woff2)$">
ExpiresDefault "access plus 1 year"
</FilesMatch>
# Videos and their posters: one hour. This block comes after the images so it wins for the posters.
<FilesMatch "(\.mp4|-poster\.jpg)$">
ExpiresDefault "access plus 1 hour"
</FilesMatch>
# The curtain's footage and still: one week. Last, so it wins over the hour above.
<FilesMatch "^fair-(loop\.(webm|mp4)|poster\.jpg)$">
ExpiresDefault "access plus 1 week"
</FilesMatch>
</IfModule>

<IfModule mod_headers.c>
# Images, logos and icons: one week.
<FilesMatch "\.(jpe?g|png|webp|avif|svg|ico|webmanifest)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
# Hashed build files (assets/) and fonts: one year, never changes under the same name.
<FilesMatch "\.(js|css|woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
# Videos and their posters: one hour. This block comes after the images so it wins for the posters.
<FilesMatch "(\.mp4|-poster\.jpg)$">
Header set Cache-Control "public, max-age=3600"
</FilesMatch>
# The curtain's footage and still: one week. Last, so it wins over the hour above.
<FilesMatch "^fair-(loop\.(webm|mp4)|poster\.jpg)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
</IfModule>
